{
  "expo": {
    "name": "Thesis Foodservice App",
    "slug": "thesis-foodservice-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "thesisfoodservice",
    "userInterfaceStyle": "light",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "photosPermission": "Allow access to select food photos for your menu.", "cameraPermission": false, "microphonePermission": false }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF9F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
