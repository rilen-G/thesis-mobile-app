    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "pg": "^8.23.0",
